# sync writes every component, in config order, with mode 0600.
exec envhaul sync
stdout '^wrote +api/.env +\(6 vars\)$'
stdout '^wrote +web/.env +\(2 vars\)$'
stderr 'warning: 1 referenced value not found'
stderr 'api.OPTIONAL: ssm:/app/dev/api/OPTIONAL@acme-dev not found'
cmp api/.env want-api.env
cmp web/.env want-web.env
[!windows] mode api/.env 0600

# A second run leaves identical files alone.
exec envhaul sync api
stdout '^unchanged +api/.env'
! stdout web

# --strict fails on missing values and writes nothing.
rm web/.env
! exec envhaul sync --strict
stderr '1 referenced value\(s\) not found \(strict mode\)'
stderr 'api.OPTIONAL'
! exists web/.env

# Unknown components are rejected with the available names.
! exec envhaul sync nope
stderr 'unknown component "nope" \(available: api, web\)'

-- envhaul.yaml --
name: dev
aws_profile: acme-dev
aws_region: us-east-1
ssm_prefix: /app/dev
components:
  api:
    env_file: api/.env
    vars:
      ENV: dev
      OPENAI_API_KEY: "{{ssm:api/OPENAI_API_KEY@acme-shared}}"
      DB_URL: "postgresql://{{secret:db#user}}:{{secret:db#pass|urlencode}}@localhost:5432/app"
      OPTIONAL: "{{ssm:api/OPTIONAL}}"
      WITH_DEFAULT: "{{ssm:api/NOPE|default:http://localhost:8000}}"
      QUOTED: "{{ssm:/shared/greeting}}"
  web:
    env_file: web/.env
    vars:
      VITE_API: "http://localhost:8000"
      VITE_SENTRY_DSN: "{{ssm:api/SENTRY_DSN@acme-shared}}"
-- fake-aws.json --
{
  "ssm": {
    "acme-shared|/app/dev/api/OPENAI_API_KEY": "sk-test-123",
    "acme-shared|/app/dev/api/SENTRY_DSN": "https://abc@sentry.example/1",
    "acme-dev|/shared/greeting": "hello world, it's me"
  },
  "secret": {
    "acme-dev|db": "{\"user\": \"admin\", \"pass\": \"p@ss w/rd\"}"
  }
}
-- want-api.env --
# Generated by envhaul from envhaul.yaml (dev). Do not edit; changes are overwritten.
# Regenerate with: envhaul sync api

ENV=dev
OPENAI_API_KEY=sk-test-123
DB_URL=postgresql://admin:p%40ss%20w%2Frd@localhost:5432/app
OPTIONAL=
WITH_DEFAULT=http://localhost:8000
QUOTED="hello world, it's me"
-- want-web.env --
# Generated by envhaul from envhaul.yaml (dev). Do not edit; changes are overwritten.
# Regenerate with: envhaul sync web

VITE_API=http://localhost:8000
VITE_SENTRY_DSN=https://abc@sentry.example/1
