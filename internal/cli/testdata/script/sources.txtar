# The non-AWS sources validate offline, show their resolved paths in list,
# and resolve through sync (1Password here, with a fake `op`).
exec envhaul validate
stdout 'is valid: 2 components, 6 variables, 6 references'

exec envhaul list
cmp stdout want-list.txt

exec envhaul sync app
cmp app.env want.env

# Mistakes in each scheme are caught offline, with positions.
! exec envhaul -c bad.yaml validate
stderr '^bad.yaml:6:11: vault path "app/" must name a secret, not a directory'
stderr '^bad.yaml:7:11: 1Password reference "Dev/db" must be vault/item/field or vault/item/section/field'
stderr '^bad.yaml:8:11: Secret Manager secret name "bad.name"'
stderr '^bad.yaml:9:11: Key Vault reference "db-password" needs a vault'
stderr '^bad.yaml:11:3: unknown key "url"'
stderr 'invalid: 5 problems'

-- envhaul.yaml --
vault:
  mount: kv
onepassword:
  account: team.1password.com
  profiles:
    work:
      account: work.1password.com
gcp:
  project: dev-project
azure:
  vault: dev-kv
components:
  app:
    env_file: app.env
    vars:
      DB_PASSWORD: "{{op:Dev/db/password}}"
      WORK_TOKEN: "{{op:op://Ops/token/credential@work}}"
  cloud:
    env_file: cloud.env
    vars:
      API_KEY: "{{vault:team/api#key}}"
      SA_KEY: "{{gcp:service-key:3}}"
      PROD_DB: "{{gcp:db-password@prod-project}}"
      KV_SECRET: "{{azkv:db-password}}"
-- fake-aws.json --
{"op": {"team.1password.com|Dev/db/password": "s3cret pass", "work.1password.com|Ops/token/credential": "w-token"}}
-- want-list.txt --
COMPONENT  VAR          SOURCE
app        DB_PASSWORD  op:Dev/db/password
app        WORK_TOKEN   op:Ops/token/credential@work
cloud      API_KEY      vault:kv/team/api#key
cloud      SA_KEY       gcp:projects/dev-project/secrets/service-key/versions/3
cloud      PROD_DB      gcp:projects/prod-project/secrets/db-password/versions/latest@prod-project
cloud      KV_SECRET    azkv:dev-kv/db-password
-- want.env --
# Generated by envhaul from envhaul.yaml. Do not edit; changes are overwritten.
# Regenerate with: envhaul sync app

DB_PASSWORD='s3cret pass'
WORK_TOKEN=w-token
-- bad.yaml --
components:
  app:
    env_file: .env
    vars:
      ok: x
      V: "{{vault:app/}}"
      O: "{{op:Dev/db}}"
      G: "{{gcp:bad.name}}"
      A: "{{azkv:db-password}}"
vault:
  url: https://vault.example.com
